# Environment
NODE_ENV=development

# App
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aisocialos_dev

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-change-this-in-production
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# Cookie
COOKIE_SECRET=your-cookie-salt-for-hashing-tokens

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:3000/api/social-accounts/linkedin/callback

# Email (Production only - dev mode prints to terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@connectus.dev

# Encryption (for social account tokens)
ENCRYPTION_KEY=

# Redis (future)
REDIS_URL=

# OpenAI (future)
OPENAI_API_KEY=

# Logging
LOG_LEVEL=debug
